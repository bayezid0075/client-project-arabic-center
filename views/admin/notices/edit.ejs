<div class="page-header">
  <div>
    <span class="label">[ EDIT NOTICE ]</span>
    <h2><%= notice.title %></h2>
  </div>
  <a href="/admin/notices/<%= notice.id %>" class="btn btn--outline">&larr; BACK</a>
</div>

<div class="card">
  <div class="card-body">
    <form action="/admin/notices/<%= notice.id %>/update" method="POST">
      <div class="form-group">
        <label class="form-label">Title *</label>
        <input type="text" name="title" class="form-input" value="<%= notice.title %>" required placeholder="Notice title" maxlength="200">
      </div>
      <div class="form-group">
        <label class="form-label">Summary</label>
        <input type="text" name="summary" class="form-input" value="<%= notice.summary || '' %>" placeholder="Brief summary for marquee display" maxlength="300">
      </div>
      <div class="form-group">
        <label class="form-label">Content</label>
        <textarea name="content" class="form-textarea" rows="8" placeholder="Full notice content (supports plain text)"><%= notice.content || '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label">Link (Optional)</label>
        <input type="url" name="link" class="form-input" value="<%= notice.link || '' %>" placeholder="https://example.com (leave empty if not needed)">
        <small style="color: var(--muted); font-size: 0.75rem;">Add a link to show a clickable button in the notice. Leave empty if not needed.</small>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Pin to Top</label>
          <select name="is_pinned" class="form-select">
            <option value="0" <%= !notice.is_pinned ? 'selected' : '' %>>No</option>
            <option value="1" <%= notice.is_pinned ? 'selected' : '' %>>Yes - Show first in marquee</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Status</label>
          <select name="is_active" class="form-select">
            <option value="1" <%= notice.is_active ? 'selected' : '' %>>Active - Visible on website</option>
            <option value="0" <%= !notice.is_active ? 'selected' : '' %>>Inactive - Hidden from website</option>
          </select>
        </div>
      </div>
      <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
        <button type="submit" class="btn btn--primary">UPDATE NOTICE</button>
        <a href="/admin/notices/<%= notice.id %>" class="btn btn--outline">CANCEL</a>
      </div>
    </form>
  </div>
</div>
