<div class="page-header">
  <div>
    <span class="label">[ NOTICE #<%= notice.id %> ]</span>
    <h2><%= notice.title %></h2>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <a href="/admin/notices/<%= notice.id %>/edit" class="btn btn--outline">EDIT</a>
    <a href="/admin/notices" class="btn btn--ghost">&larr; BACK</a>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-header">
    <h3>NOTICE DETAILS</h3>
    <div style="display: flex; gap: 0.5rem;">
      <% if (notice.is_pinned) { %><span class="badge badge--high">PINNED</span><% } %>
      <span class="badge badge--<%= notice.is_active ? 'active' : 'inactive' %>"><%= notice.is_active ? 'ACTIVE' : 'INACTIVE' %></span>
    </div>
  </div>
  <div class="detail-card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <span class="label">TITLE</span>
        <span class="value"><%= notice.title %></span>
      </div>
      <div class="detail-item">
        <span class="label">CREATED</span>
        <span class="value"><%= notice.created_at ? new Date(notice.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></span>
      </div>
      <div class="detail-item">
        <span class="label">SUMMARY (MARQUEE)</span>
        <span class="value"><%= notice.summary || 'No summary set' %></span>
      </div>
      <div class="detail-item">
        <span class="label">LAST UPDATED</span>
        <span class="value"><%= notice.updated_at ? new Date(notice.updated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></span>
      </div>
    </div>
  </div>
</div>

<% if (notice.content) { %>
<div class="detail-card" style="margin-top: 1.5rem;">
  <div class="detail-card-header">
    <h3>FULL CONTENT</h3>
  </div>
  <div class="detail-card-body">
    <p style="color: var(--muted); line-height: 1.7; white-space: pre-wrap;"><%= notice.content %></p>
  </div>
</div>
<% } %>

<div style="margin-top: 1.5rem;">
  <form action="/admin/notices/<%= notice.id %>/delete" method="POST" data-confirm="Are you sure you want to delete this notice? This action cannot be undone.">
    <button type="submit" class="btn btn--danger">DELETE NOTICE</button>
  </form>
</div>
