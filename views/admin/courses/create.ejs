<div class="page-header">
  <div>
    <span class="label">[ NEW COURSE ]</span>
    <h2>ADD NEW COURSE</h2>
  </div>
  <a href="/admin/courses" class="btn btn--outline">&larr; BACK TO LIST</a>
</div>

<div class="card">
  <div class="card-body">
    <form action="/admin/courses" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Course Name *</label>
          <input type="text" name="name" class="form-input" required placeholder="e.g. Web Development" maxlength="150">
        </div>
        <div class="form-group">
          <label class="form-label">Course Code *</label>
          <input type="text" name="code" class="form-input" required placeholder="e.g. WEB-101" maxlength="20" style="text-transform: uppercase;">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-textarea" rows="4" placeholder="Course description and overview..."></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Duration</label>
          <input type="text" name="duration" class="form-input" placeholder="e.g. 3 months, 12 weeks">
        </div>
        <div class="form-group">
          <label class="form-label">Fee (&#2547;)</label>
          <input type="number" name="fee" class="form-input" min="0" step="0.01" value="0" placeholder="0.00">
        </div>
      </div>

      <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <span class="label">[ BATCHES ]</span>
        <h3 style="margin: 0.5rem 0 1rem;">ADD BATCHES</h3>
      </div>

      <div id="batchContainer">
        <div class="batch-row" style="background: var(--card-bg); border: 1px solid var(--border); padding: 1rem; margin-bottom: 1rem;">
          <div class="form-row">
            <div class="form-group" style="flex: 2;">
              <label class="form-label">Batch Name *</label>
              <input type="text" name="batches[0][name]" class="form-input" required placeholder="e.g. Batch A, Morning Batch" maxlength="100">
            </div>
            <div class="form-group">
              <label class="form-label">Max Students</label>
              <input type="number" name="batches[0][max_students]" class="form-input" min="1" value="30" placeholder="30">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Start Date</label>
              <input type="date" name="batches[0][start_date]" class="form-input">
            </div>
            <div class="form-group">
              <label class="form-label">End Date</label>
              <input type="date" name="batches[0][end_date]" class="form-input">
            </div>
          </div>
        </div>
      </div>

      <button type="button" class="btn btn--outline" onclick="addBatch()" style="margin-bottom: 1rem;">+ ADD ANOTHER BATCH</button>

      <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
        <button type="submit" class="btn btn--primary">CREATE COURSE</button>
        <a href="/admin/courses" class="btn btn--outline">CANCEL</a>
      </div>
    </form>
  </div>
</div>

<script>
let batchIndex = 1;

function addBatch() {
  const container = document.getElementById('batchContainer');
  const html = `
    <div class="batch-row" style="background: var(--card-bg); border: 1px solid var(--border); padding: 1rem; margin-bottom: 1rem; position: relative;">
      <button type="button" onclick="removeBatch(this)" style="position: absolute; top: 0.5rem; right: 0.5rem; background: var(--red); color: white; border: none; padding: 0.25rem 0.5rem; cursor: pointer; font-size: 0.75rem;">&times; REMOVE</button>
      <div class="form-row">
        <div class="form-group" style="flex: 2;">
          <label class="form-label">Batch Name *</label>
          <input type="text" name="batches[${batchIndex}][name]" class="form-input" required placeholder="e.g. Batch A, Morning Batch" maxlength="100">
        </div>
        <div class="form-group">
          <label class="form-label">Max Students</label>
          <input type="number" name="batches[${batchIndex}][max_students]" class="form-input" min="1" value="30" placeholder="30">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Start Date</label>
          <input type="date" name="batches[${batchIndex}][start_date]" class="form-input">
        </div>
        <div class="form-group">
          <label class="form-label">End Date</label>
          <input type="date" name="batches[${batchIndex}][end_date]" class="form-input">
        </div>
      </div>
    </div>
  `;
  container.insertAdjacentHTML('beforeend', html);
  batchIndex++;
}

function removeBatch(btn) {
  btn.closest('.batch-row').remove();
}
</script>
