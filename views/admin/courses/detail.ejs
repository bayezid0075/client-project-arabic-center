<div class="page-header">
  <div>
    <span class="label">[ COURSE RECORD #<%= course.code %> ]</span>
    <h2><%= course.name %></h2>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <a href="/admin/courses/<%= course.id %>/edit" class="btn btn--outline">EDIT</a>
    <a href="/admin/courses" class="btn btn--ghost">&larr; BACK</a>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-header">
    <h3>COURSE INFORMATION</h3>
    <span class="badge badge--<%= course.is_active ? 'active' : 'inactive' %>"><%= course.is_active ? 'Active' : 'Inactive' %></span>
  </div>
  <div class="detail-card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <span class="label">COURSE CODE</span>
        <span class="value mono"><%= course.code %></span>
      </div>
      <div class="detail-item">
        <span class="label">COURSE NAME</span>
        <span class="value"><%= course.name %></span>
      </div>
      <div class="detail-item">
        <span class="label">DURATION</span>
        <span class="value"><%= course.duration || 'N/A' %></span>
      </div>
      <div class="detail-item">
        <span class="label">FEE</span>
        <span class="value mono">&#2547; <%= parseFloat(course.fee).toLocaleString() %></span>
      </div>
      <div class="detail-item">
        <span class="label">ENROLLED STUDENTS</span>
        <span class="value mono"><%= course.student_count %></span>
      </div>
      <div class="detail-item">
        <span class="label">TOTAL BATCHES</span>
        <span class="value mono"><%= course.batch_count %></span>
      </div>
      <% if (batches.length > 0) { %>
      <div class="detail-item">
        <span class="label">CURRENT BATCH</span>
        <span class="value"><%= batches[0].name %></span>
      </div>
      <div class="detail-item">
        <span class="label">BATCH START DATE</span>
        <span class="value"><%= batches[0].start_date ? new Date(batches[0].start_date).toLocaleDateString() : 'N/A' %></span>
      </div>
      <% } %>
      <div class="detail-item" style="grid-column: 1 / -1;">
        <span class="label">DESCRIPTION</span>
        <span class="value"><%= course.description || 'No description provided.' %></span>
      </div>
    </div>
  </div>
</div>

<div class="detail-card" style="margin-top: 1.5rem;">
  <div class="detail-card-header">
    <h3>BATCHES (<%= batches.length %>)</h3>
  </div>
  <div class="detail-card-body">
    <% if (batches.length > 0) { %>
    <div class="admin-table-card">
      <div class="table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th>BATCH NAME</th>
              <th>START DATE</th>
              <th>END DATE</th>
              <th>MAX STUDENTS</th>
              <th>STATUS</th>
            </tr>
          </thead>
          <tbody>
            <% batches.forEach(function(batch) { %>
            <tr>
              <td><strong><%= batch.name %></strong></td>
              <td><%= batch.start_date ? new Date(batch.start_date).toLocaleDateString() : 'N/A' %></td>
              <td><%= batch.end_date ? new Date(batch.end_date).toLocaleDateString() : 'N/A' %></td>
              <td class="mono"><%= batch.max_students %></td>
              <td><span class="badge badge--<%= batch.is_active ? 'active' : 'inactive' %>"><%= batch.is_active ? 'Active' : 'Inactive' %></span></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } else { %>
    <div class="empty-state">
      <p>No batches have been created for this course yet.</p>
    </div>
    <% } %>
  </div>
</div>

<div class="detail-card" style="margin-top: 1.5rem;">
  <div class="detail-card-header">
    <h3>METADATA</h3>
  </div>
  <div class="detail-card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <span class="label">CREATED</span>
        <span class="value"><%= course.created_at ? new Date(course.created_at).toLocaleString() : 'N/A' %></span>
      </div>
      <div class="detail-item">
        <span class="label">LAST UPDATED</span>
        <span class="value"><%= course.updated_at ? new Date(course.updated_at).toLocaleString() : 'N/A' %></span>
      </div>
    </div>
  </div>
</div>
