<div class="page-header">
  <div>
    <span class="label">[ ISSUE #<%= issue.issue_id %> ]</span>
    <h2><%= issue.subject %></h2>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <a href="/admin/issues/<%= issue.id %>/edit" class="btn btn--outline">EDIT</a>
    <a href="/admin/issues" class="btn btn--ghost">&larr; BACK</a>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-header">
    <h3>ISSUE INFORMATION</h3>
    <div style="display: flex; gap: 0.5rem;">
      <span class="badge badge--<%= issue.priority %>"><%= issue.priority.toUpperCase() %></span>
      <span class="badge badge--<%= issue.status %>"><%= issue.status.toUpperCase() %></span>
    </div>
  </div>
  <div class="detail-card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <span class="label">ISSUE ID</span>
        <span class="value mono"><%= issue.issue_id %></span>
      </div>
      <div class="detail-item">
        <span class="label">STUDENT</span>
        <span class="value"><%= issue.student_name %> <span class="mono" style="color: var(--muted);">(<%= issue.student_code %>)</span></span>
      </div>
      <div class="detail-item">
        <span class="label">ISSUE TYPE</span>
        <span class="value"><%= issue.issue_type.charAt(0).toUpperCase() + issue.issue_type.slice(1) %></span>
      </div>
      <div class="detail-item">
        <span class="label">ASSIGNED TO</span>
        <span class="value"><%= issue.assigned_to || 'Unassigned' %></span>
      </div>
      <div class="detail-item">
        <span class="label">CREATED</span>
        <span class="value"><%= issue.created_at ? new Date(issue.created_at).toLocaleDateString() : 'N/A' %></span>
      </div>
      <div class="detail-item">
        <span class="label">RESOLVED</span>
        <span class="value"><%= issue.resolved_date ? new Date(issue.resolved_date).toLocaleDateString() : 'N/A' %></span>
      </div>
    </div>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-header">
    <h3>DESCRIPTION</h3>
  </div>
  <div class="detail-card-body">
    <p style="color: var(--muted); line-height: 1.7;"><%= issue.description || 'No description provided.' %></p>
  </div>
</div>

<% if (issue.resolution_notes) { %>
<div class="detail-card">
  <div class="detail-card-header">
    <h3>RESOLUTION NOTES</h3>
  </div>
  <div class="detail-card-body">
    <p style="color: var(--muted); line-height: 1.7;"><%= issue.resolution_notes %></p>
  </div>
</div>
<% } %>

<div style="margin-top: 1.5rem;">
  <form action="/admin/issues/<%= issue.id %>/delete" method="POST" data-confirm="Are you sure you want to delete this issue?">
    <button type="submit" class="btn btn--danger btn--sm">DELETE ISSUE</button>
  </form>
</div>
