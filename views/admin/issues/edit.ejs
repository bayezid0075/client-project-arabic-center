<div class="page-header">
  <div>
    <span class="label">[ EDIT ISSUE #<%= issue.issue_id %> ]</span>
    <h2><%= issue.subject %></h2>
  </div>
  <a href="/admin/issues/<%= issue.id %>" class="btn btn--outline">&larr; BACK</a>
</div>

<div class="card">
  <div class="card-body">
    <form action="/admin/issues/<%= issue.id %>/update" method="POST">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Issue ID</label>
          <input type="text" class="form-input" value="<%= issue.issue_id %>" readonly>
        </div>
        <div class="form-group">
          <label class="form-label">Student *</label>
          <select name="student_id" class="form-select" required>
            <% students.forEach(function(student) { %>
              <option value="<%= student.id %>" <%= issue.student_id == student.id ? 'selected' : '' %>><%= student.full_name %> (<%= student.student_id %>)</option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Issue Type</label>
          <select name="issue_type" class="form-select">
            <option value="payment" <%= issue.issue_type === 'payment' ? 'selected' : '' %>>Payment Issue</option>
            <option value="attendance" <%= issue.issue_type === 'attendance' ? 'selected' : '' %>>Attendance Issue</option>
            <option value="certificate" <%= issue.issue_type === 'certificate' ? 'selected' : '' %>>Certificate Issue</option>
            <option value="course" <%= issue.issue_type === 'course' ? 'selected' : '' %>>Course Issue</option>
            <option value="technical" <%= issue.issue_type === 'technical' ? 'selected' : '' %>>Technical Issue</option>
            <option value="administrative" <%= issue.issue_type === 'administrative' ? 'selected' : '' %>>Administrative Issue</option>
            <option value="other" <%= issue.issue_type === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Subject *</label>
          <input type="text" name="subject" class="form-input" value="<%= issue.subject %>" required>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-textarea" rows="4"><%= issue.description || '' %></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Priority</label>
          <select name="priority" class="form-select">
            <option value="low" <%= issue.priority === 'low' ? 'selected' : '' %>>Low</option>
            <option value="medium" <%= issue.priority === 'medium' ? 'selected' : '' %>>Medium</option>
            <option value="high" <%= issue.priority === 'high' ? 'selected' : '' %>>High</option>
            <option value="urgent" <%= issue.priority === 'urgent' ? 'selected' : '' %>>Urgent</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option value="open" <%= issue.status === 'open' ? 'selected' : '' %>>Open</option>
            <option value="in_progress" <%= issue.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
            <option value="resolved" <%= issue.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
            <option value="closed" <%= issue.status === 'closed' ? 'selected' : '' %>>Closed</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Assigned To</label>
        <input type="text" name="assigned_to" class="form-input" value="<%= issue.assigned_to || '' %>">
      </div>
      <div class="form-group">
        <label class="form-label">Resolution Notes</label>
        <textarea name="resolution_notes" class="form-textarea" rows="3"><%= issue.resolution_notes || '' %></textarea>
      </div>
      <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
        <button type="submit" class="btn btn--primary">UPDATE ISSUE</button>
        <a href="/admin/issues/<%= issue.id %>" class="btn btn--outline">CANCEL</a>
      </div>
    </form>
  </div>
</div>
