<div class="page-header">
  <div>
    <span class="label">[ INVOICE #<%= invoice.invoice_number %> ]</span>
    <h2>Invoice Details</h2>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <a href="/admin/invoices/<%= invoice.id %>/edit" class="btn btn--outline">EDIT</a>
    <a href="/admin/invoices/<%= invoice.id %>/print" class="btn btn--primary" target="_blank">PRINT</a>
    <a href="/admin/invoices" class="btn btn--ghost">&larr; BACK</a>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-header">
    <h3>INVOICE INFORMATION</h3>
    <span class="badge badge--<%= invoice.payment_status %>"><%= invoice.payment_status.toUpperCase() %></span>
  </div>
  <div class="detail-card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <span class="label">INVOICE NUMBER</span>
        <span class="value mono"><%= invoice.invoice_number %></span>
      </div>
      <div class="detail-item">
        <span class="label">STUDENT</span>
        <span class="value"><%= invoice.student_name %></span>
      </div>
      <div class="detail-item">
        <span class="label">COURSE</span>
        <span class="value"><%= invoice.course_name || 'N/A' %></span>
      </div>
      <div class="detail-item">
        <span class="label">DESCRIPTION</span>
        <span class="value"><%= invoice.description || 'N/A' %></span>
      </div>
      <div class="detail-item">
        <span class="label">ISSUE DATE</span>
        <span class="value"><%= invoice.issue_date ? new Date(invoice.issue_date).toLocaleDateString() : 'N/A' %></span>
      </div>
      <div class="detail-item">
        <span class="label">DUE DATE</span>
        <span class="value"><%= invoice.due_date ? new Date(invoice.due_date).toLocaleDateString() : 'N/A' %></span>
      </div>
    </div>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-header">
    <h3>PAYMENT SUMMARY</h3>
  </div>
  <div class="detail-card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <span class="label">SUBTOTAL</span>
        <span class="value mono">&#2547; <%= parseFloat(invoice.amount).toLocaleString() %></span>
      </div>
      <div class="detail-item">
        <span class="label">DISCOUNT</span>
        <span class="value mono">&#2547; <%= parseFloat(invoice.discount).toLocaleString() %></span>
      </div>
      <div class="detail-item">
        <span class="label">TAX (<%= invoice.tax_rate %>%)</span>
        <span class="value mono">&#2547; <%= parseFloat(invoice.tax_amount).toLocaleString() %></span>
      </div>
      <div class="detail-item">
        <span class="label">TOTAL AMOUNT</span>
        <span class="value mono" style="font-size: 1.25rem; font-weight: 700;">&#2547; <%= parseFloat(invoice.total_amount).toLocaleString() %></span>
      </div>
      <div class="detail-item">
        <span class="label">PAID AMOUNT</span>
        <span class="value mono" style="color: var(--green);">&#2547; <%= parseFloat(invoice.paid_amount).toLocaleString() %></span>
      </div>
      <div class="detail-item">
        <span class="label">DUE AMOUNT</span>
        <span class="value mono" style="color: <%= parseFloat(invoice.due_amount) > 0 ? 'var(--red)' : 'var(--green)' %>;">&#2547; <%= parseFloat(invoice.due_amount).toLocaleString() %></span>
      </div>
    </div>
  </div>
</div>

<% if (invoice.notes) { %>
<div class="detail-card">
  <div class="detail-card-header">
    <h3>NOTES</h3>
  </div>
  <div class="detail-card-body">
    <p style="color: var(--muted);"><%= invoice.notes %></p>
  </div>
</div>
<% } %>

<div style="margin-top: 1.5rem;">
  <form action="/admin/invoices/<%= invoice.id %>/delete" method="POST" data-confirm="Are you sure you want to delete this invoice?">
    <button type="submit" class="btn btn--danger btn--sm">DELETE INVOICE</button>
  </form>
</div>
