<div class="page-header">
  <div>
    <span class="label">[ NEW INVOICE ]</span>
    <h2>CREATE NEW INVOICE</h2>
  </div>
  <a href="/admin/invoices" class="btn btn--outline">&larr; BACK TO LIST</a>
</div>

<div class="card">
  <div class="card-body">
    <form action="/admin/invoices" method="POST" id="invoiceForm">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Invoice Number</label>
          <input type="text" name="invoice_number" class="form-input" value="<%= invoiceNumber %>" readonly>
        </div>
        <div class="form-group">
          <label class="form-label">Student *</label>
          <select name="student_id" id="studentSelect" class="form-select" required>
            <option value="" data-fee="0" data-invoiced="0" data-due="0" data-course-id="">Select Student</option>
            <% students.forEach(function(student) { %>
              <option value="<%= student.id %>"
                      data-fee="<%= parseFloat(student.course_fee || 0) %>"
                      data-invoiced="<%= parseFloat(student.invoiced_total || 0) %>"
                      data-due="<%= parseFloat(student.due_amount || 0) %>"
                      data-course-id="<%= student.course_id || '' %>"><%= student.full_name %> (<%= student.student_id %>)<% if (student.has_billing_limit) { %> &mdash; Due &#2547; <%= parseFloat(student.due_amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %><% } %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="form-group" id="billingPanel" style="display: none;">
        <label class="form-label">COURSE PRICE SUMMARY</label>
        <div style="display: flex; gap: 2.5rem; flex-wrap: wrap; padding: 0.75rem 0;">
          <div>
            <span class="label">COURSE FEE</span>
            <div id="billingFee" class="mono" style="font-size: 1.1rem; font-weight: 700;">&#2547; 0.00</div>
          </div>
          <div>
            <span class="label">ALREADY INVOICED</span>
            <div id="billingInvoiced" class="mono" style="font-size: 1.1rem; font-weight: 700;">&#2547; 0.00</div>
          </div>
          <div>
            <span class="label">DUE AMOUNT</span>
            <div id="billingDue" class="mono" style="font-size: 1.1rem; font-weight: 700;">&#2547; 0.00</div>
          </div>
        </div>
        <p id="billingHint" style="font-size: 0.8rem; color: var(--muted); margin-top: 0.25rem;"></p>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Course</label>
          <select name="course_id" id="course_id" class="form-select">
            <option value="">Select Course</option>
            <% courses.forEach(function(course) { %>
              <option value="<%= course.id %>"><%= course.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Issue Date</label>
          <input type="date" name="issue_date" class="form-input" value="<%= new Date().toISOString().split('T')[0] %>">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-textarea" rows="2" placeholder="Invoice description"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Amount *</label>
          <input type="number" name="amount" id="amount" class="form-input" step="0.01" min="0" required placeholder="0.00">
          <small id="amountHint" style="display: block; margin-top: 0.35rem; font-size: 0.75rem; color: var(--muted);"></small>
        </div>
        <div class="form-group">
          <label class="form-label">Discount</label>
          <input type="number" name="discount" id="discount" class="form-input" step="0.01" min="0" value="0" placeholder="0.00">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Tax Rate (%)</label>
          <input type="number" name="tax_rate" id="tax_rate" class="form-input" step="0.01" min="0" max="100" value="0" placeholder="0">
        </div>
        <div class="form-group">
          <label class="form-label">Paid Amount</label>
          <input type="number" name="paid_amount" class="form-input" step="0.01" min="0" value="0" placeholder="0.00">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">TOTAL AMOUNT</label>
          <div id="totalDisplay" style="font-family: var(--font-mono); font-size: 1.5rem; font-weight: 700; padding: 0.625rem 0;">&#2547; 0.00</div>
          <div id="billingWarning" style="display: none; font-size: 0.8rem; font-weight: 700; color: var(--danger, #e11d48);"></div>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Notes</label>
        <textarea name="notes" class="form-textarea" rows="2" placeholder="Additional notes"></textarea>
      </div>
      <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
        <button type="submit" class="btn btn--primary">CREATE INVOICE</button>
        <a href="/admin/invoices" class="btn btn--outline">CANCEL</a>
      </div>
    </form>
  </div>
</div>
