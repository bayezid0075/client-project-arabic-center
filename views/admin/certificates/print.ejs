<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Certificate - <%= certificate.certificate_number %> | Raabed Technical Training & Language Center</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=IBM+Plex+Mono:wght@400;500;600&family=UnifrakturMaguntia&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Cormorant Garamond', serif; background: #f0f0f0; }
    @page { size: A4 landscape; margin: 0; }

    .certificate {
      width: 297mm;
      height: 210mm;
      margin: 0 auto;
      background: #fffdf7;
      position: relative;
      padding: 10mm;
      overflow: hidden;
    }

    /* Watermark PNG backgrounds */
    .cert-bg-wave {
      position: absolute;
      pointer-events: none;
      z-index: 0;
      opacity: 0.08;
    }
    .cert-bg-wave.wave-top-left {
      top: -30px;
      left: -30px;
      width: 300px;
      height: auto;
      transform: rotate(-15deg);
    }
    .cert-bg-wave.wave-bottom-right {
      bottom: -30px;
      right: -30px;
      width: 300px;
      height: auto;
      transform: rotate(165deg) scaleX(-1);
    }

    /* Logo watermark - center */
    .cert-watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 240px;
      height: 240px;
      object-fit: contain;
      opacity: 0.5;
      pointer-events: none;
      z-index: 0;
    }

    /* Classic certificate frame: double rules + ornamental chain band */
    .cert-frame {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
    }

    /* Header layout */
    .cert-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      width: 100%;
      position: relative;
      z-index: 3;
      margin-bottom: 5mm;
      padding: 0 5mm;
    }

    .cert-header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cert-header-logo {
    width: 100px;
    height: 100px;
    /* margin-left: 19px; */
    object-fit: contain;
    border: 2px solid #c0392b;
    padding: 3px;
    background: #fff;
    margin-top: 11px;
    }

    .cert-header-info {
      text-align: center;
    }

    .cert-center-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #1a1a6e;
    margin-bottom: 2px;
    text-transform: uppercase;
    margin-top: 35px;
    }

    .cert-center-address {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: #333;
    margin-bottom: 1px;
    }

    .cert-center-website {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.0rem;
      color: #333;
      font-weight: 600;
    }

    .cert-header-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 60px;
    }

    .cert-student-photo {
      width: 80px;
      height: 100px;
      object-fit: cover;
      border: 2px solid #8B6914;
      padding: 2px;
      background: #fff;
      margin-top: -18px;
    }

    /* Certificate metadata (right side) */
    .cert-meta-right {
    position: absolute;
    top: 56mm;
    right: 15mm;
    text-align: right;
    z-index: 3;
    }

    .cert-meta-right-item {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.6rem;
      color: #333;
      margin-bottom: 3px;
    }

    .cert-meta-right-item span {
      font-weight: 600;
    }

    /* Content */
    .cert-content {
    text-align: center;
    position: relative;
    z-index: 3;
    padding: 25px 21mm;
    margin-top: 43px;
    }

    /* Title using ornate calligraphic font */
    .cert-title {
    font-family: 'UnifrakturMaguntia', cursive;
    font-size: 2.6rem;
    color: #1a1a1a;
    margin-bottom: 9mm;
    line-height: 1.1;
    }

    .cert-certify-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1rem;
      color: #333;
      margin-bottom: 3mm;
    }

    .cert-student-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 2mm;
      text-transform: uppercase;
    }

    .cert-passport {
      font-family: 'Cormorant Garamond', serif;
      font-size: 0.85rem;
      color: #333;
      margin-bottom: 4mm;
    }

    .cert-completion-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: #333;
    font-style: italic;
    margin-bottom: 3mm;
    line-height: 1.4;
    }

    .cert-course {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 4mm;
      text-transform: uppercase;
    }

    .cert-date-range {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.0rem;
    color: #333;
    font-style: italic;
    margin-bottom: 3mm;
    line-height: 1.4;
    font-weight: 700;
    }

    .cert-issue-date {
    text-align: left;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    color: #333;
    font-style: italic;
    margin-top: 22mm;
    font-weight: 900;
    }

    /* Footer layout */
    .cert-footer {
      position: absolute;
      bottom: 15mm;
      left: 15mm;
      right: 15mm;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      z-index: 3;
    }

    .cert-footer-section {
      text-align: center;
    }

    .cert-footer-signature-img {
      height: 58px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      margin-bottom: 4px;
    }

    .cert-footer-signature-img img {
      max-width: 135px;
      max-height: 58px;
      object-fit: contain;
    }

    .cert-footer-signature-line {
      width: 130px;
      border-top: 1px solid #333;
      margin-bottom: 4px;
    }

    .cert-footer-signature-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.0rem;
      font-weight: 600;
      color: #1a1a1a;
    }

    .cert-footer-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
    }

    .cert-footer-stamp {
      width: 88px;
      height: 88px;
      object-fit: contain;
      opacity: 0.9;
    }

    .cert-footer-qr {
      text-align: center;
    }

    .cert-footer-qr img {
      width: 65px;
      height: 65px;
    }

    .cert-footer-qr-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.4rem;
      color: #999;
      margin-top: 2px;
    }

    .print-btn {
      position: fixed; top: 1rem; right: 1rem; z-index: 1000;
      padding: 0.5rem 1rem; background: #5a4a1f; color: #fff; border: none;
      font-family: 'Cormorant Garamond', serif; font-size: 0.8rem; font-weight: 600;
      cursor: pointer; text-transform: uppercase; letter-spacing: 0.1em;
    }
    .print-btn:hover { background: #8B6914; }

    /* Screen only: scale the fixed A4 sheet down to fit small viewports */
    .cert-viewport {
      width: 100%;
      overflow: hidden;
    }

    .certificate {
      transform-origin: top left;
    }

    @media print {
      .print-btn { display: none; }
      body { background: white; }
      .certificate { margin: 0; box-shadow: none; transform: none !important; }
      .cert-viewport { height: auto !important; overflow: visible !important; }
    }
  </style>
</head>
<body>
  <button class="print-btn" onclick="window.print()">PRINT CERTIFICATE</button>

  <div class="cert-viewport">
  <div class="certificate">
    <!-- Background watermark PNGs -->
    <img src="/images/wave-gradient.png" alt="" class="cert-bg-wave wave-top-left">
    <img src="/images/wave-colorful.png" alt="" class="cert-bg-wave wave-bottom-right">

    <!-- Logo watermark - center -->
    <img src="/images/logo.png" alt="" class="cert-watermark">

    <!-- Classic certificate frame: double rules, ornamental band, corner cartouches -->
    <svg class="cert-frame" viewBox="0 0 2970 2100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <pattern id="certBandH" width="80" height="70" patternUnits="userSpaceOnUse">
          <g fill="none" stroke="#8B6914" stroke-width="3.2" stroke-linecap="round">
            <path d="M0 7.3H80"/>
            <path d="M0 62.7H80"/>
            <path d="M40 16L59 35L40 54L21 35Z"/>
            <path d="M10 35H21M59 35H70"/>
            <circle cx="0" cy="35" r="10"/>
            <circle cx="80" cy="35" r="10"/>
          </g>
          <path d="M40 24.3L50.7 35L40 45.7L29.3 35Z" fill="#8B6914"/>
        </pattern>
        <pattern id="certBandV" width="70" height="80" patternUnits="userSpaceOnUse">
          <g fill="none" stroke="#8B6914" stroke-width="3.2" stroke-linecap="round">
            <path d="M7.3 0V80"/>
            <path d="M62.7 0V80"/>
            <path d="M16 40L35 21L54 40L35 59Z"/>
            <path d="M35 10V21M35 59V70"/>
            <circle cx="35" cy="0" r="10"/>
            <circle cx="35" cy="80" r="10"/>
          </g>
          <path d="M35 29.3L45.7 40L35 50.7L24.3 40Z" fill="#8B6914"/>
        </pattern>
        <g id="certCorner" fill="none" stroke="#8B6914" stroke-linecap="round">
          <path d="M130 22.4C71.5 22.4 22.4 71.5 22.4 130" stroke-width="3.2"/>
          <path d="M130 77.9C74.8 77.9 77.9 74.8 77.9 130" stroke-width="3.2"/>
          <path d="M0 59.8C0 26 26 0 59.8 0" stroke-width="3"/>
          <path d="M54.2 43.8L64.6 54.2L54.2 64.6L43.8 54.2Z" stroke-width="3" fill="#fffdf7"/>
          <path d="M54.2 49L59.4 54.2L54.2 59.4L49 54.2Z" fill="#8B6914" stroke="none"/>
        </g>
      </defs>

      <!-- Frame rules -->
      <rect x="18" y="18" width="2934" height="2064" fill="none" stroke="#8B6914" stroke-width="3"/>
      <rect x="30" y="30" width="2910" height="2040" fill="none" stroke="#8B6914" stroke-width="5"/>
      <rect x="128" y="128" width="2714" height="1844" fill="none" stroke="#8B6914" stroke-width="4.5"/>
      <rect x="140" y="140" width="2690" height="1820" fill="none" stroke="#8B6914" stroke-width="3"/>

      <!-- Ornamental band -->
      <rect x="160" y="45" width="2650" height="70" fill="url(#certBandH)"/>
      <rect x="160" y="1985" width="2650" height="70" fill="url(#certBandH)"/>
      <rect x="45" y="160" width="70" height="1780" fill="url(#certBandV)"/>
      <rect x="2855" y="160" width="70" height="1780" fill="url(#certBandV)"/>

      <!-- Corner cartouches -->
      <use href="#certCorner" transform="translate(30,30)"/>
      <use href="#certCorner" transform="translate(2940,30) scale(-1,1)"/>
      <use href="#certCorner" transform="translate(30,2070) scale(1,-1)"/>
      <use href="#certCorner" transform="translate(2940,2070) scale(-1,-1)"/>
    </svg>

    <!-- Header -->
    <div class="cert-header">
      <div class="cert-header-left">
        <img src="/images/logo.png" alt="RTTLC Logo" class="cert-header-logo">
        <div class="cert-header-info">
          <div class="cert-center-name">Arabian Technical Training Center</div>
          <div class="cert-center-address">Utholi, Shibalay, Manikganj</div>
          <div class="cert-center-website">Website : arabianttc.com</div>
        </div>
      </div>
      <div class="cert-header-right">
        <% if (certificate.profile_photo) { %>
          <img src="<%= certificate.profile_photo %>" alt="Student Photo" class="cert-student-photo">
        <% } else { %>
          <div class="cert-student-photo" style="display:flex;align-items:center;justify-content:center;background:#f5f5f5;color:#ccc;font-size:0.5rem;">PHOTO</div>
        <% } %>
      </div>
    </div>

    <!-- Certificate metadata (right side) -->
    <div class="cert-meta-right">
      <div class="cert-meta-right-item">Certificate No: <span><%= certificate.certificate_number %></span></div>
      <% if (certificate.registration_no) { %>
        <div class="cert-meta-right-item">Registration No.: <span><%= certificate.registration_no %></span></div>
      <% } %>
    </div>

    <!-- Content -->
    <div class="cert-content">
      <div class="cert-title">Certificate of completion</div>

      <div class="cert-certify-text">This is to certify that</div>

      <div class="cert-student-name"><%= certificate.student_name %></div>

      <% if (certificate.passport_no) { %>
        <div class="cert-passport">Passport No: <%= certificate.passport_no %></div>
      <% } %>

      <div class="cert-completion-text">has successfully completed practical and theoretical training course on</div>

      <div class="cert-course"><%= certificate.course_name || 'Professional Training Program' %></div>

      <div class="cert-date-range">
        From <%= certificate.batch_start_date ? new Date(certificate.batch_start_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : (certificate.completion_date ? new Date(certificate.completion_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : 'N/A') %>
        to <%= certificate.batch_end_date ? new Date(certificate.batch_end_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : (certificate.issue_date ? new Date(certificate.issue_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : 'N/A') %>
        with hard work and dedication that contributes to his/her good results.
      </div>

      <div class="cert-issue-date">Issue Date: <%= certificate.issue_date ? new Date(certificate.issue_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : 'N/A' %></div>
    </div>

    <!-- Footer -->
    <div class="cert-footer">
      <div class="cert-footer-section">
        <div class="cert-footer-signature-img">
          <img src="/images/exam-controller-sign.png" alt="Exam Controller Signature">
        </div>
        <div class="cert-footer-signature-line"></div>
        <div class="cert-footer-signature-name">Exam Controller</div>
      </div>

      <div class="cert-footer-center">
        <img src="/images/ins-seal.png" alt="Center Seal" class="cert-footer-stamp">
      </div>

      <div class="cert-footer-qr">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(baseUrl + '/verify/' + certificate.verification_code) %>" alt="Scan to verify certificate">
        <div class="cert-footer-qr-label">SCAN TO VERIFY</div>
      </div>

      <div class="cert-footer-section">
        <div class="cert-footer-signature-img">
          <img src="/images/administraiton-sign.png" alt="Administrator Signature">
        </div>
        <div class="cert-footer-signature-line"></div>
        <div class="cert-footer-signature-name">Administrator</div>
      </div>
    </div>
  </div>
  </div>

  <script>
    (function () {
      var cert = document.querySelector('.certificate');
      var vp = document.querySelector('.cert-viewport');
      if (!cert || !vp) return;

      function fit() {
        var avail = document.documentElement.clientWidth;
        var w = cert.offsetWidth;
        if (avail >= w) {
          cert.style.transform = '';
          vp.style.height = '';
          return;
        }
        var s = avail / w;
        cert.style.transform = 'scale(' + s + ')';
        vp.style.height = Math.ceil(cert.offsetHeight * s) + 'px';
      }

      fit();
      window.addEventListener('resize', fit);
      window.addEventListener('beforeprint', function () {
        cert.style.transform = '';
        vp.style.height = '';
      });
      window.addEventListener('afterprint', fit);
    })();
  </script>
</body>
</html>
