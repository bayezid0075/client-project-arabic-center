<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Certificate - <%= certificate.certificate_number %></title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Space Grotesk', sans-serif; background: #f0f0f0; }
    @page { size: A4 landscape; margin: 0; }
    .certificate {
      width: 297mm;
      height: 210mm;
      margin: 0 auto;
      background: #fff;
      position: relative;
      padding: 20mm;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .cert-border {
      position: absolute;
      top: 10mm;
      left: 10mm;
      right: 10mm;
      bottom: 10mm;
      border: 2px solid #111;
    }
    .cert-corner {
      position: absolute;
      width: 30px;
      height: 30px;
      border: 2px solid #E85D04;
    }
    .cert-corner.tl { top: 15mm; left: 15mm; border-right: none; border-bottom: none; }
    .cert-corner.tr { top: 15mm; right: 15mm; border-left: none; border-bottom: none; }
    .cert-corner.bl { bottom: 15mm; left: 15mm; border-right: none; border-top: none; }
    .cert-corner.br { bottom: 15mm; right: 15mm; border-left: none; border-top: none; }
    .cert-content { text-align: center; position: relative; z-index: 1; }
    .cert-logo { font-size: 2rem; color: #111; margin-bottom: 0.5rem; }
    .cert-logo span { color: #E85D04; }
    .cert-center-name { font-size: 1.5rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1.5rem; }
    .cert-title { font-size: 2.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; color: #111; }
    .cert-subtitle { font-size: 0.9rem; color: #666; margin-bottom: 1.5rem; font-style: italic; }
    .cert-presents { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.2em; color: #888; margin-bottom: 0.5rem; }
    .cert-student-name { font-size: 2.2rem; font-weight: 700; color: #111; margin-bottom: 0.5rem; border-bottom: 2px solid #E85D04; display: inline-block; padding-bottom: 0.25rem; }
    .cert-for { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.2em; color: #888; margin-bottom: 0.5rem; margin-top: 1rem; }
    .cert-course { font-size: 1.5rem; font-weight: 600; color: #2455A4; margin-bottom: 1.5rem; }
    .cert-meta { display: flex; justify-content: center; gap: 3rem; margin-bottom: 1.5rem; font-size: 0.8rem; }
    .cert-meta-item { text-align: center; }
    .cert-meta-item .label { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.15em; color: #888; margin-bottom: 0.25rem; font-family: 'IBM Plex Mono', monospace; }
    .cert-meta-item .value { font-weight: 600; font-family: 'IBM Plex Mono', monospace; }
    .cert-footer { display: flex; justify-content: space-between; width: 70%; margin-top: 1rem; }
    .cert-signature { text-align: center; }
    .cert-signature-line { width: 150px; border-top: 1px solid #111; margin-bottom: 0.25rem; }
    .cert-signature-name { font-size: 0.75rem; font-weight: 600; }
    .cert-signature-title { font-size: 0.65rem; color: #888; }
    .cert-number { position: absolute; bottom: 15mm; right: 20mm; font-family: 'IBM Plex Mono', monospace; font-size: 0.65rem; color: #aaa; }
    .cert-verification { position: absolute; bottom: 15mm; left: 20mm; font-family: 'IBM Plex Mono', monospace; font-size: 0.65rem; color: #aaa; }
    .print-btn {
      position: fixed; top: 1rem; right: 1rem; z-index: 1000;
      padding: 0.5rem 1rem; background: #111; color: #fff; border: none;
      font-family: 'Space Grotesk', sans-serif; font-size: 0.8rem; font-weight: 600;
      cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em;
    }
    .print-btn:hover { background: #E85D04; }
    @media print {
      .print-btn { display: none; }
      body { background: white; }
      .certificate { margin: 0; box-shadow: none; }
    }
  </style>
</head>
<body>
  <button class="print-btn" onclick="window.print()">PRINT CERTIFICATE</button>

  <div class="certificate">
    <div class="cert-border"></div>
    <div class="cert-corner tl"></div>
    <div class="cert-corner tr"></div>
    <div class="cert-corner bl"></div>
    <div class="cert-corner br"></div>

    <div class="cert-content">
      <div class="cert-logo">&#9632; TRAINING <span>CENTER</span></div>
      <div class="cert-center-name">Professional Training Institute</div>

      <div class="cert-title">CERTIFICATE OF COMPLETION</div>
      <div class="cert-subtitle">This certificate is proudly presented to</div>

      <div class="cert-student-name"><%= certificate.student_name %></div>

      <div class="cert-for">For successfully completing</div>
      <div class="cert-course"><%= certificate.course_name || 'Professional Training Program' %></div>

      <div class="cert-meta">
        <div class="cert-meta-item">
          <div class="label">Completion Date</div>
          <div class="value"><%= certificate.completion_date ? new Date(certificate.completion_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></div>
        </div>
        <div class="cert-meta-item">
          <div class="label">Grade</div>
          <div class="value"><%= certificate.grade || 'N/A' %></div>
        </div>
        <div class="cert-meta-item">
          <div class="label">Result</div>
          <div class="value"><%= certificate.result ? certificate.result.toUpperCase() : 'N/A' %></div>
        </div>
      </div>

      <div class="cert-footer">
        <div class="cert-signature">
          <div class="cert-signature-line"></div>
          <div class="cert-signature-name">Director</div>
          <div class="cert-signature-title">Training Center</div>
        </div>
        <div class="cert-signature">
          <div class="cert-signature-line"></div>
          <div class="cert-signature-name">Instructor</div>
          <div class="cert-signature-title"><%= certificate.course_name || 'Program' %></div>
        </div>
      </div>
    </div>

    <div class="cert-number">Certificate No: <%= certificate.certificate_number %></div>
    <div class="cert-verification">Verification: <%= certificate.verification_code %></div>
  </div>
</body>
</html>
