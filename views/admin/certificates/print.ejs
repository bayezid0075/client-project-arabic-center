<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Certificate - <%= certificate.certificate_number %> | Raabed Technical Training & Language Center</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=IBM+Plex+Mono:wght@400;500;600&family=UnifrakturMaguntia&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Cormorant Garamond', serif; background: #f0f0f0; }
    @page { size: A4 landscape; margin: 0; }

    .certificate {
      width: 297mm;
      height: 210mm;
      margin: 0 auto;
      background: #fffdf7;
      position: relative;
      padding: 10mm;
      overflow: hidden;
    }

    /* Watermark PNG backgrounds */
    .cert-bg-wave {
      position: absolute;
      pointer-events: none;
      z-index: 0;
      opacity: 0.08;
    }
    .cert-bg-wave.wave-top-left {
      top: -30px;
      left: -30px;
      width: 300px;
      height: auto;
      transform: rotate(-15deg);
    }
    .cert-bg-wave.wave-bottom-right {
      bottom: -30px;
      right: -30px;
      width: 300px;
      height: auto;
      transform: rotate(165deg) scaleX(-1);
    }

    /* Logo watermark - center */
    .cert-watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 240px;
      height: 240px;
      object-fit: contain;
      opacity: 0.04;
      pointer-events: none;
      z-index: 0;
    }

    /* Classic double border */
    .cert-border-outer {
      position: absolute;
      top: 7mm;
      left: 7mm;
      right: 7mm;
      bottom: 7mm;
      border: 3px solid #8B6914;
      pointer-events: none;
      z-index: 1;
    }
    .cert-border-inner {
      position: absolute;
      top: 10mm;
      left: 10mm;
      right: 10mm;
      bottom: 10mm;
      border: 1px solid #8B6914;
      pointer-events: none;
      z-index: 1;
    }

    /* Classic ornamental corners */
    .cert-corner {
      position: absolute;
      width: 45px;
      height: 45px;
      pointer-events: none;
      z-index: 2;
    }
    .cert-corner::before,
    .cert-corner::after {
      content: '';
      position: absolute;
      background: #8B6914;
    }
    .cert-corner.tl { top: 8mm; left: 8mm; }
    .cert-corner.tl::before { top: 0; left: 0; width: 45px; height: 2px; }
    .cert-corner.tl::after { top: 0; left: 0; width: 2px; height: 45px; }

    .cert-corner.tr { top: 8mm; right: 8mm; }
    .cert-corner.tr::before { top: 0; right: 0; width: 45px; height: 2px; }
    .cert-corner.tr::after { top: 0; right: 0; width: 2px; height: 45px; }

    .cert-corner.bl { bottom: 8mm; left: 8mm; }
    .cert-corner.bl::before { bottom: 0; left: 0; width: 45px; height: 2px; }
    .cert-corner.bl::after { bottom: 0; left: 0; width: 2px; height: 45px; }

    .cert-corner.br { bottom: 8mm; right: 8mm; }
    .cert-corner.br::before { bottom: 0; right: 0; width: 45px; height: 2px; }
    .cert-corner.br::after { bottom: 0; right: 0; width: 2px; height: 45px; }

    /* Corner ornaments (diamond shapes) */
    .cert-ornament {
      position: absolute;
      width: 12px;
      height: 12px;
      background: #8B6914;
      transform: rotate(45deg);
      z-index: 2;
    }
    .cert-ornament.orn-tl { top: 12mm; left: 12mm; }
    .cert-ornament.orn-tr { top: 12mm; right: 12mm; }
    .cert-ornament.orn-bl { bottom: 12mm; left: 12mm; }
    .cert-ornament.orn-br { bottom: 12mm; right: 12mm; }

    /* Header layout */
    .cert-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      width: 100%;
      position: relative;
      z-index: 3;
      margin-bottom: 5mm;
      padding: 0 5mm;
    }

    .cert-header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cert-header-logo {
    width: 100px;
    height: 100px;
    /* margin-left: 19px; */
    object-fit: contain;
    border: 2px solid #c0392b;
    padding: 3px;
    background: #fff;
    margin-top: 65px;
    }

    .cert-header-info {
      text-align: center;
    }

    .cert-center-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.35rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #1a1a6e;
    margin-bottom: 2px;
    text-transform: uppercase;
    margin-top: 35px;
    }

    .cert-center-address {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: #333;
    margin-bottom: 1px;
    }

    .cert-center-website {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.0rem;
      color: #333;
      font-weight: 600;
    }

    .cert-header-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 60px;
    }

    .cert-student-photo {
      width: 80px;
      height: 100px;
      object-fit: cover;
      border: 2px solid #8B6914;
      padding: 2px;
      background: #fff;
    }

    /* Certificate metadata (right side) */
    .cert-meta-right {
    position: absolute;
    top: 56mm;
    right: 15mm;
    text-align: right;
    z-index: 3;
    }

    .cert-meta-right-item {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.6rem;
      color: #333;
      margin-bottom: 3px;
    }

    .cert-meta-right-item span {
      font-weight: 600;
    }

    /* Content */
    .cert-content {
    text-align: center;
    position: relative;
    z-index: 3;
    padding: 25px 21mm;
    margin-top: 43px;
    }

    /* Title using ornate calligraphic font */
    .cert-title {
    font-family: 'UnifrakturMaguntia', cursive;
    font-size: 2.6rem;
    color: #1a1a1a;
    margin-bottom: 9mm;
    line-height: 1.1;
    }

    .cert-certify-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1rem;
      color: #333;
      margin-bottom: 3mm;
    }

    .cert-student-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 2mm;
      text-transform: uppercase;
    }

    .cert-passport {
      font-family: 'Cormorant Garamond', serif;
      font-size: 0.85rem;
      color: #333;
      margin-bottom: 4mm;
    }

    .cert-completion-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    color: #333;
    font-style: italic;
    margin-bottom: 3mm;
    line-height: 1.4;
    }

    .cert-course {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 4mm;
      text-transform: uppercase;
    }

    .cert-date-range {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.0rem;
    color: #333;
    font-style: italic;
    margin-bottom: 3mm;
    line-height: 1.4;
    font-weight: 700;
    }

    .cert-issue-date {
    text-align: left;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    color: #333;
    font-style: italic;
    margin-top: 22mm;
    font-weight: 900;
    }

    /* Footer layout */
    .cert-footer {
      position: absolute;
      bottom: 15mm;
      left: 15mm;
      right: 15mm;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      z-index: 3;
    }

    .cert-footer-section {
      text-align: center;
    }

    .cert-footer-signature-line {
      width: 130px;
      border-top: 1px solid #333;
      margin-bottom: 4px;
    }

    .cert-footer-signature-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.0rem;
      font-weight: 600;
      color: #1a1a1a;
    }

    .cert-footer-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
    }

    .cert-footer-stamp {
      width: 70px;
      height: 70px;
      object-fit: contain;
      opacity: 0.85;
    }

    .cert-footer-qr {
      text-align: center;
    }

    .cert-footer-qr img {
      width: 65px;
      height: 65px;
    }

    .cert-footer-qr-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.4rem;
      color: #999;
      margin-top: 2px;
    }

    .print-btn {
      position: fixed; top: 1rem; right: 1rem; z-index: 1000;
      padding: 0.5rem 1rem; background: #5a4a1f; color: #fff; border: none;
      font-family: 'Cormorant Garamond', serif; font-size: 0.8rem; font-weight: 600;
      cursor: pointer; text-transform: uppercase; letter-spacing: 0.1em;
    }
    .print-btn:hover { background: #8B6914; }

    @media print {
      .print-btn { display: none; }
      body { background: white; }
      .certificate { margin: 0; box-shadow: none; }
    }
  </style>
</head>
<body>
  <button class="print-btn" onclick="window.print()">PRINT CERTIFICATE</button>

  <div class="certificate">
    <!-- Background watermark PNGs -->
    <img src="/images/wave-gradient.png" alt="" class="cert-bg-wave wave-top-left">
    <img src="/images/wave-colorful.png" alt="" class="cert-bg-wave wave-bottom-right">

    <!-- Logo watermark - center -->
    <img src="/images/logo.png" alt="" class="cert-watermark">

    <!-- Classic borders -->
    <div class="cert-border-outer"></div>
    <div class="cert-border-inner"></div>

    <!-- Corner lines -->
    <div class="cert-corner tl"></div>
    <div class="cert-corner tr"></div>
    <div class="cert-corner bl"></div>
    <div class="cert-corner br"></div>

    <!-- Corner ornaments -->
    <div class="cert-ornament orn-tl"></div>
    <div class="cert-ornament orn-tr"></div>
    <div class="cert-ornament orn-bl"></div>
    <div class="cert-ornament orn-br"></div>

    <!-- Header -->
    <div class="cert-header">
      <div class="cert-header-left">
        <img src="/images/logo.png" alt="RTTLC Logo" class="cert-header-logo">
        <div class="cert-header-info">
          <div class="cert-center-name">Arabic Technical Training Center</div>
          <div class="cert-center-address">53, Nimitolir Tck, Diabari, Turag, Uttara, Dhaka-1230</div>
          <div class="cert-center-website">Website : rttlcbd.com</div>
        </div>
      </div>
      <div class="cert-header-right">
        <% if (certificate.profile_photo) { %>
          <img src="<%= certificate.profile_photo %>" alt="Student Photo" class="cert-student-photo">
        <% } else { %>
          <div class="cert-student-photo" style="display:flex;align-items:center;justify-content:center;background:#f5f5f5;color:#ccc;font-size:0.5rem;">PHOTO</div>
        <% } %>
      </div>
    </div>

    <!-- Certificate metadata (right side) -->
    <div class="cert-meta-right">
      <div class="cert-meta-right-item">Certificate No: <span><%= certificate.certificate_number %></span></div>
      <% if (certificate.registration_no) { %>
        <div class="cert-meta-right-item">Registration No.: <span><%= certificate.registration_no %></span></div>
      <% } %>
    </div>

    <!-- Content -->
    <div class="cert-content">
      <div class="cert-title">Certificate of completion</div>

      <div class="cert-certify-text">This is to certify that</div>

      <div class="cert-student-name"><%= certificate.student_name %></div>

      <% if (certificate.passport_no) { %>
        <div class="cert-passport">Passport No: <%= certificate.passport_no %></div>
      <% } %>

      <div class="cert-completion-text">has successfully completed practical and theoretical training course on</div>

      <div class="cert-course"><%= certificate.course_name || 'Professional Training Program' %></div>

      <div class="cert-date-range">
        From <%= certificate.batch_start_date ? new Date(certificate.batch_start_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : (certificate.completion_date ? new Date(certificate.completion_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : 'N/A') %>
        to <%= certificate.batch_end_date ? new Date(certificate.batch_end_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : (certificate.issue_date ? new Date(certificate.issue_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : 'N/A') %>
        with hard work and dedication that contributes to his/her good results.
      </div>

      <div class="cert-issue-date">Issue Date: <%= certificate.issue_date ? new Date(certificate.issue_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') : 'N/A' %></div>
    </div>

    <!-- Footer -->
    <div class="cert-footer">
      <div class="cert-footer-section">
        <div style="height: 40px;"></div>
        <div class="cert-footer-signature-line"></div>
        <div class="cert-footer-signature-name">Exam Controller</div>
      </div>

      <div class="cert-footer-center">
        <img src="/images/logo.png" alt="Center Stamp" class="cert-footer-stamp">
      </div>

      <div class="cert-footer-qr">
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(baseUrl + '/verify/' + certificate.verification_code) %>" alt="Scan to verify certificate">
        <div class="cert-footer-qr-label">SCAN TO VERIFY</div>
      </div>

      <div class="cert-footer-section">
        <div style="height: 40px;"></div>
        <div class="cert-footer-signature-line"></div>
        <div class="cert-footer-signature-name">Administrator</div>
      </div>
    </div>
  </div>
</body>
</html>
