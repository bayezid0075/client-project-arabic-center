<section class="about-hero">
  <div class="container">
    <span class="label" style="color: var(--orange);">[ OUR PROGRAMS ]</span>
    <h1>TRAINING COURSES</h1>
    <p>Industry-relevant programs designed to build practical skills and advance careers.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="label">[ AVAILABLE PROGRAMS ]</span>
      <h2>EXPLORE OUR COURSES</h2>
      <p>Choose from our comprehensive range of professional training programs.</p>
    </div>

    <% if (typeof courses !== 'undefined' && courses && courses.length > 0) { %>
    <div class="courses-grid">
      <% courses.forEach(function(course) { %>
      <div class="course-card">
        <span class="course-code"><%= course.code %></span>
        <h3><%= course.name %></h3>
        <p><%= course.description ? course.description.substring(0, 120) + '...' : '' %></p>
        <div class="course-meta">
          <span class="duration"><%= course.duration || 'N/A' %></span>
          <span class="fee">&#2547; <%= parseFloat(course.fee).toLocaleString() %></span>
        </div>
        <% if (course.batches && course.batches.length > 0) { %>
        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border); font-size: 0.8rem;">
          <strong>Available Batches:</strong>
          <% course.batches.forEach(function(batch, i) { %>
            <div style="color: var(--muted); margin-top: 0.25rem;">
              <%= batch.name %>
              <% if (batch.start_date) { %> - Starts <%= new Date(batch.start_date).toLocaleDateString() %><% } %>
            </div>
          <% }); %>
        </div>
        <% } %>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <p>Courses are being updated. Please check back later.</p>
    </div>
    <% } %>
  </div>
</section>
