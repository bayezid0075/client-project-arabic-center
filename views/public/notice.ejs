<section class="section">
  <div class="container" style="max-width: 800px;">
    <a href="/" style="display: inline-block; margin-bottom: 1.5rem; color: var(--muted); text-decoration: none; font-size: 0.85rem;">&larr; Back to Home</a>

    <div class="notice-card">
      <span class="label">[ NOTICE ]</span>
      <h1 style="margin: 0.75rem 0 1rem; font-size: 1.8rem;"><%= notice.title %></h1>

      <div class="notice-meta">
        <span>Published: <%= notice.created_at ? new Date(notice.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></span>
        <% if (notice.is_pinned) { %><span style="color: var(--red);">&#128204; Pinned</span><% } %>
      </div>

      <% if (notice.summary) { %>
      <div style="font-size: 1.1rem; color: var(--ink); line-height: 1.8; margin-bottom: 1.5rem; font-style: italic; border-left: 3px solid var(--orange); padding-left: 1rem;">
        <%= notice.summary %>
      </div>
      <% } %>

      <% if (notice.content) { %>
      <div style="color: var(--muted); line-height: 1.8; white-space: pre-wrap; margin-bottom: 1.5rem;"><%= notice.content %></div>
      <% } else { %>
      <p style="color: var(--muted); margin-bottom: 1.5rem;">No additional details available.</p>
      <% } %>

      <% if (notice.link) { %>
      <a href="<%= notice.link %>" target="_blank" class="btn btn--primary" style="display: inline-block;">Learn More &rarr;</a>
      <% } %>
    </div>
  </div>
</section>
