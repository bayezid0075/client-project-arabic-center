<section class="page-hero">
  <div class="container">
    <span class="label">[ EVENTS & ANNOUNCEMENTS ]</span>
    <h1>OUR EVENTS</h1>
    <p>Stay updated with our latest events, workshops, seminars, and training sessions.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (events && events.length > 0) { %>
    <div class="events-grid">
      <% events.forEach(function(ev) { %>
      <a href="/events/<%= ev.slug %>" class="event-card">
        <div class="event-card-image">
          <% if (ev.image) { %>
            <img src="<%= ev.image %>" alt="<%= ev.title %>">
          <% } else { %>
            <div class="event-card-placeholder">
              <span class="event-card-date-day"><%= new Date(ev.event_date).getDate() %></span>
              <span class="event-card-date-month"><%= new Date(ev.event_date).toLocaleDateString('en-US', { month: 'short' }) %></span>
            </div>
          <% } %>
          <% if (ev.is_featured) { %>
            <span class="event-card-badge">FEATURED</span>
          <% } %>
        </div>
        <div class="event-card-body">
          <div class="event-card-meta">
            <span class="event-card-date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <%= new Date(ev.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
            </span>
            <% if (ev.location) { %>
            <span class="event-card-location">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <%= ev.location %>
            </span>
            <% } %>
          </div>
          <h3 class="event-card-title"><%= ev.title %></h3>
          <% if (ev.summary) { %>
            <p class="event-card-summary"><%= ev.summary.substring(0, 120) %><%= ev.summary.length > 120 ? '...' : '' %></p>
          <% } %>
          <span class="event-card-link">Read More &rarr;</span>
        </div>
      </a>
      <% }); %>
    </div>

    <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (page > 1) { %>
        <a href="/events?page=<%= page - 1 %>" class="pagination-btn">&laquo; Prev</a>
      <% } %>
      <% for (var i = 1; i <= totalPages; i++) { %>
        <a href="/events?page=<%= i %>" class="pagination-btn<%= i === page ? ' active' : '' %>"><%= i %></a>
      <% } %>
      <% if (page < totalPages) { %>
        <a href="/events?page=<%= page + 1 %>" class="pagination-btn">Next &raquo;</a>
      <% } %>
    </div>
    <% } %>

    <% } else { %>
    <div class="empty-state" style="padding: 4rem 1.5rem;">
      <span class="label">[ NO EVENTS ]</span>
      <h3>NO UPCOMING EVENTS</h3>
      <p>There are no events scheduled at the moment. Check back soon for updates!</p>
      <a href="/" class="btn btn--primary" style="margin-top: 1rem;">BACK TO HOME</a>
    </div>
    <% } %>
  </div>
</section>
